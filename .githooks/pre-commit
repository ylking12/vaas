#!/bin/bash
# VaaS 项目 pre-commit hook
# 安装方法（项目根目录执行一次）:
#   git config core.hooksPath .githooks
#
# 检查规则（仅警告，不阻止提交）:
#   1. 改了 frontend/ 或 backend/ 源码但没改 TASK_TRACKING.md
#   2. 改了 scripts/ 但没改 README.md 脚本章节
#   3. 改了 docs/plans/ 但没在 TASK_TRACKING.md 引用

YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

warn()  { echo -e "${YELLOW}[pre-commit WARN]${NC} $1"; }
info()  { echo -e "${BLUE}[pre-commit]${NC} $1"; }

# 获取本次提交修改的文件
CHANGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)
if [ -z "$CHANGED" ]; then
  exit 0
fi

WARNINGS=0

# 规则 1: 改源码 → TASK_TRACKING.md 也应改
SRC_CHANGED=$(echo "$CHANGED" | grep -E "^(frontend/dashboard/src/|backend/[^/]+/src/)" || true)
TRACKING_CHANGED=$(echo "$CHANGED" | grep -E "^TASK_TRACKING\.md$" || true)
if [ -n "$SRC_CHANGED" ] && [ -z "$TRACKING_CHANGED" ]; then
  warn "检测到源码改动但未同步 TASK_TRACKING.md"
  warn "  改动: $(echo "$SRC_CHANGED" | head -3 | tr '\n' ' ')"
  warn "  建议: 在 TASK_TRACKING.md 中记录本次变更（项目规则强制要求）"
  WARNINGS=$((WARNINGS+1))
fi

# 规则 2: 改 scripts/ → README.md 脚本章节也应改
SCRIPTS_CHANGED=$(echo "$CHANGED" | grep -E "^scripts/.*\.sh$" || true)
README_CHANGED=$(echo "$CHANGED" | grep -E "^README\.md$" || true)
if [ -n "$SCRIPTS_CHANGED" ] && [ -z "$README_CHANGED" ]; then
  warn "检测到 scripts/ 改动但未同步 README.md"
  warn "  改动: $(echo "$SCRIPTS_CHANGED" | tr '\n' ' ')"
  warn "  建议: 在 README.md「脚本工具」章节补充新脚本说明"
  WARNINGS=$((WARNINGS+1))
fi

# 规则 3: 新增 docs/plans/ 文件 → TASK_TRACKING.md 应有引用
NEW_PLANS=$(echo "$CHANGED" | grep -E "^docs/plans/.*\.md$" || true)
if [ -n "$NEW_PLANS" ] && [ -z "$TRACKING_CHANGED" ]; then
  warn "检测到 docs/plans/ 新增文档但未在 TASK_TRACKING.md 引用"
  warn "  改动: $(echo "$NEW_PLANS" | tr '\n' ' ')"
  WARNINGS=$((WARNINGS+1))
fi

# 规则 4: 改了 PROJECT_RULES.md / CLAUDE.md → 提醒确认影响范围
RULES_CHANGED=$(echo "$CHANGED" | grep -E "^(PROJECT_RULES|CLAUDE)\.md$" || true)
if [ -n "$RULES_CHANGED" ]; then
  warn "项目规则文件变更：$(echo "$RULES_CHANGED" | tr '\n' ' ')"
  warn "  请确认团队成员已同步新规则"
  WARNINGS=$((WARNINGS+1))
fi

if [ "$WARNINGS" -gt 0 ]; then
  echo ""
  info "共 $WARNINGS 条提醒（不阻止提交，确认后用 git commit --no-verify 跳过）"
fi

exit 0
