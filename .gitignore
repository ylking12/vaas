# --- Reference decompiled (large binaries) ---
reference/decompiled-jar/
reference/decompiled-admin/*.beautified.js

# --- Python virtual env (large binaries from decompilation) ---
reference/**/venv/
reference/**/*venv/
reference/**/*.so

# --- Backup JARs ---
*.jar.bak

# --- Python cache ---
__pycache__/
*.pyc
*.pyo
.venv/

# --- Credentials ---
.env
.env.*
!.env.example
config/password.txt
backend/config/password.txt
backend/admin-api/config/password.txt
backend/admin-api/src/main/resources/passwd
*.pem
*.key
*.p12
*.jks
*.keystore

# --- Release archives ---
*.tar.gz
*.zip

# --- Claude local settings ---
.claude/settings.local.json

# --- Runtime logs ---
backend/**/logs/

# --- Dashboard build/deploy artifacts ---
frontend/dashboard/www/

# --- Large image assets ---
frontend/dashboard/public/img/*.png
frontend/dashboard/public/road_network_image/  # 原版路网图 132MB（运行时由 vite 引用，不进 git）
frontend/admin/dist/             # Vite 构建产物（dashboard 已 ignore dist/）

# --- Editor temp files ---
*.swp                            # vim
*.swo                            # vim
*~                               # emacs/backup
*.iws                            # IntelliJ workspace
*.pid.lock                       # 防止并发启动冲突
